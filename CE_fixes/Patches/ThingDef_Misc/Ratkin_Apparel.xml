		defName="RK_RoyalCrown" or 
		defName="RK_ResearchGlasses" or 
		defName="RK_EarCostume" or 
		defName="RK_StrawHat"
		]/statBases</xpath>
		<value>
			<Bulk>1</Bulk>
			<WornBulk>1</WornBulk>
		</value>
	</Operation>
	
