			defName="RK_FlatColorCoat" or
			defName="RK_GaurdenUniform" or
			defName="RK_ChefSuit" or
			defName="RK_WorkerWear" or
			defName="RK_ExplorerWear" or
			defName="RK_SummerDress" or			
			defName="RK_ResearchGown" or
			defName="RK_FrillOnepiece" or
			defName="RK_FlatColorCoat" or
			defName="RK_ApronSkirt" or
			defName="RK_SantaRobe" or
			defName="RK_WinterRobe" or
			defName="RK_RoyalRobe" or
			defName="RK_Cardigan" or
			defName="RK_SistersVeil" or
			defName="RK_ChefHat" or
			defName="RK_SantaHat" or
			defName="RK_Coif" or
			defName="RK_WoolenHat" or
			defName="RK_ExplorerHat" or
			defName="RK_RoyalCrown"
		]/statBases/StuffEffectMultiplierArmor</xpath>
	</Operation>
	
	<!-- Civilian hats bulk -->
