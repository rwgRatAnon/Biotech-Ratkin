<?xml version="1.0" encoding="utf-8"?>

<Patch>
	<!-- Ratkin Gunlance (Normal & Spread) -->
	<!-- Ratkin Gunlance (Normal) -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType"]/statBases</xpath>
		<value>
			<ToughnessRating>3</ToughnessRating>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_SpreadType"]/statBases</xpath>
		<value>
			<ToughnessRating>3</ToughnessRating>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType" or defName="RK_Gunlance_SpreadType"]</xpath>
		<value>
			<soundInteract>RK_Reload</soundInteract>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType" or defName="RK_Gunlance_SpreadType"]/weaponTags</xpath>
		<value>
			<li>NoSwitch</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType"]</xpath>
		<value>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<recoilAmount>3.5</recoilAmount>
					<verbClass>CombatExtended.Verb_ShootCE</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<defaultProjectile>Bullet_RK_DragonAmmo_Normal</defaultProjectile>
					<warmupTime>2</warmupTime>
					<range>2.5</range>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<soundCast>RK_FireA</soundCast>
					<soundCastTail>RK_WyvernFireA</soundCastTail>
					<muzzleFlashScale>15</muzzleFlashScale>
				</li>
			</verbs>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>3</magazineSize>
				<!--<reloadOneAtATime>true</reloadOneAtATime>-->
				<reloadTime>2.5</reloadTime>
				<ammoSet>AmmoSet_RK_DragonAmmo_Normal</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>FALSE</aiUseBurstMode>
				<aiAimMode>Snapshot</aiAimMode>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>shot</label>
					<capacities>
						<li>GunlanceShell_Normal</li>
					</capacities>
					<power>16</power>
					<cooldownTime>3</cooldownTime>
					<chanceFactor>0.1</chanceFactor>
					<armorPenetrationBlunt>6</armorPenetrationBlunt>
					<armorPenetrationSharp>0.5</armorPenetrationSharp>
					<linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>point</label>
					<capacities>
						<li>Stab</li>
					</capacities>
					<power>16</power>
					<cooldownTime>1.3</cooldownTime>
					<chanceFactor>0.5</chanceFactor>
					<armorPenetrationBlunt>8</armorPenetrationBlunt>
					<armorPenetrationSharp>2</armorPenetrationSharp>
					<linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>edge</label>
					<capacities>
						<li>Cut</li>
					</capacities>
					<power>38</power>
					<cooldownTime>2.1</cooldownTime>
					<chanceFactor>0.5</chanceFactor>
					<armorPenetrationBlunt>4</armorPenetrationBlunt>
					<armorPenetrationSharp>5</armorPenetrationSharp>
					<linkedBodyPartsGroup>Edge</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

	<!-- Ratkin Gunlance (Spread) -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_SpreadType"]</xpath>
		<value>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<recoilAmount>3.5</recoilAmount>
					<verbClass>CombatExtended.Verb_ShootCE</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<defaultProjectile>Bullet_RK_DragonAmmo_Flame</defaultProjectile>
					<warmupTime>2</warmupTime>
					<range>2.5</range>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<soundCast>RK_FireA</soundCast>
					<soundCastTail>RK_WyvernFireA</soundCastTail>
					<muzzleFlashScale>15</muzzleFlashScale>
				</li>
			</verbs>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_SpreadType"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>3</magazineSize>
				<!--<reloadOneAtATime>true</reloadOneAtATime>-->
				<reloadTime>2.5</reloadTime>
				<ammoSet>AmmoSet_RK_DragonAmmo_Flame</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>FALSE</aiUseBurstMode>
				<aiAimMode>Snapshot</aiAimMode>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_SpreadType"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>shot</label>
					<capacities>
						<li>GunlanceShell_Spread</li>
					</capacities>
					<power>16</power>
					<cooldownTime>3</cooldownTime>
					<chanceFactor>0.1</chanceFactor>
					<armorPenetrationBlunt>6</armorPenetrationBlunt>
					<armorPenetrationSharp>0.5</armorPenetrationSharp>
					<linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>point</label>
					<capacities>
						<li>Stab</li>
					</capacities>
					<power>16</power>
					<cooldownTime>1.3</cooldownTime>
					<chanceFactor>0.5</chanceFactor>
					<armorPenetrationBlunt>8</armorPenetrationBlunt>
					<armorPenetrationSharp>2</armorPenetrationSharp>
					<linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>edge</label>
					<capacities>
						<li>Cut</li>
					</capacities>
					<power>38</power>
					<cooldownTime>2.1</cooldownTime>
					<chanceFactor>0.5</chanceFactor>
					<armorPenetrationBlunt>4</armorPenetrationBlunt>
					<armorPenetrationSharp>5</armorPenetrationSharp>
					<linkedBodyPartsGroup>Edge</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType" or defName="RK_Gunlance_SpreadType"]/statBases</xpath>
		<value>
			<statBases>
				<WorkToMake>35000</WorkToMake>
				<Bulk>7</Bulk>
				<Mass>8</Mass>
				<ShotSpread>3</ShotSpread>
				<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
				<MeleeCounterParryBonus>1.28</MeleeCounterParryBonus>
			</statBases>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType" or defName="RK_Gunlance_SpreadType"]/equippedStatOffsets</xpath>
		<value>
			<equippedStatOffsets>
				<MeleeCritChance>0.2</MeleeCritChance>
				<MeleeParryChance>0.98</MeleeParryChance>
				<MeleeDodgeChance>0.8</MeleeDodgeChance>
			</equippedStatOffsets>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType" or defName="RK_Gunlance_SpreadType"]/stuffCategories/li[.="Metallic"]</xpath>
		<value>
			<li>Metallic_Weapon</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType" or defName="RK_Gunlance_SpreadType"]/comps/li[@Class="NewRatkin.CompProperties_GunlanceFuel"]</xpath>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="RK_WyvernAmmo_NormalType" or defName="RK_WyvernAmmo_SpreadType"]</xpath>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="RK_Gunlance_NormalType" or defName="RK_Gunlance_SpreadType"]</xpath>
			<value>
				<li Class="CombatExtended.GunDrawExtension">
					<DropCasingWhenReload>true</DropCasingWhenReload>
					<CasingRotationRandomRange>20</CasingRotationRandomRange>
					<!--You'll want a lower casing speed and longer casing life time for this case-->
					<CasingOffset>-0.1,0.05</CasingOffset>
					<CasingSpeedOverrideRange>1.5~2</CasingSpeedOverrideRange>
					<!--Reload drop casings doesn't follow aiming angle. negative 135 degrees make it eject up left.-->
					<CasingAngleOffset>-145</CasingAngleOffset>
					<CasingLifeTimeMultiplier>2</CasingLifeTimeMultiplier>
				</li>
			</value>
	</Operation>
</Patch>